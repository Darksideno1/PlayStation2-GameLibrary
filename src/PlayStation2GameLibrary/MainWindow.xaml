<Window x:Class="PlayStation2GameLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLAYSTATION 2 GAME LIBRARY — v0.1 BETA"
        Width="1320" Height="820" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E4E6EA" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,24">
                    <Border Width="60" Height="60" CornerRadius="12" Background="#24144B" HorizontalAlignment="Left">
                        <TextBlock Text="PS2" Foreground="White" FontWeight="Bold" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PLAYSTATION 2" FontSize="17" FontWeight="Bold" Margin="0,15,0,0" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="GAME LIBRARY" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrandPurple}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="20,12,20,20">
                    <Separator Margin="0,0,0,12" />
                    <TextBlock Text="v0.1 BETA" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock x:Name="DatabaseCountText" Text="Catalogue: 0 games" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Margin="12,0">
                    <Button Content="▦   Dashboard" HorizontalContentAlignment="Left" Click="Dashboard_Click" />
                    <Button Content="▤   Game Catalogue" HorizontalContentAlignment="Left" Background="#EDE8F6" Click="Catalogue_Click" />
                    <Button Content="▣   My Collection" HorizontalContentAlignment="Left" Click="Collection_Click" />
                    <Button Content="⇅   Import / Export" HorizontalContentAlignment="Left" Click="ImportExport_Click" />
                    <Button Content="⚙   Settings" HorizontalContentAlignment="Left" Click="Settings_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="30,25,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Game Catalogue" FontSize="27" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock x:Name="PageSubtitle" Text="Browse the global PlayStation 2 catalogue and its regional releases." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" />
                </StackPanel>
                <Button x:Name="ImportCatalogueButton" DockPanel.Dock="Right" Content="Import catalogue" Margin="10,0,0,0" Click="ImportCatalogue_Click" />
                <Button DockPanel.Dock="Right" Content="＋ Add game" VerticalAlignment="Center" Click="AddGame_Click" />
            </DockPanel>
            <Border Grid.Row="1" Background="White" CornerRadius="9" Padding="16" Margin="0,0,0,14" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0" Height="38" Padding="10,8" VerticalContentAlignment="Center" FontSize="14" TextChanged="SearchBox_TextChanged" ToolTip="Search title, developer, publisher or serial" />
                    <ComboBox x:Name="RegionFilter" Grid.Column="1" Height="38" Margin="10,0,0,0" VerticalContentAlignment="Center" SelectionChanged="RegionFilter_SelectionChanged">
                        <ComboBoxItem Content="All regions" IsSelected="True" />
                        <ComboBoxItem Content="Europe / PAL" />
                        <ComboBoxItem Content="North America" />
                        <ComboBoxItem Content="Japan" />
                        <ComboBoxItem Content="Asia" />
                        <ComboBoxItem Content="Korea" />
                        <ComboBoxItem Content="Australia" />
                        <ComboBoxItem Content="Other / Unknown" />
                    </ComboBox>
                    <Button Grid.Column="2" Content="Clear" Margin="10,0,0,0" Click="ClearFilters_Click" />
                </Grid>
            </Border>
            <DockPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock x:Name="ResultCountText" Text="0 results" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                <Button Content="Game details" Margin="14,0,0,0" Click="GameDetails_Click" />
                <TextBlock Text="  •  Select a game to inspect its regional releases" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
            <Border Grid.Row="3" Background="White" CornerRadius="9" BorderBrush="#E5E7EB" BorderThickness="1" Padding="8">
                <DataGrid x:Name="GamesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="39" SelectionChanged="GamesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Game title" Binding="{Binding Title}" Width="2.3*" />
                        <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="70" />
                        <DataGridTextColumn Header="Developer" Binding="{Binding Developer}" Width="1.2*" />
                        <DataGridTextColumn Header="Known releases" Binding="{Binding ReleaseCount}" Width="115" />
                        <DataGridTextColumn Header="Languages" Binding="{Binding Languages}" Width="1.2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Row="4" Background="#EEEAF5" CornerRadius="7" Padding="12,9" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText" Text="Local catalogue database will be created on first launch. No online account required." Foreground="#4A356F" FontSize="12" />
            </Border>
        </Grid>
    </Grid>
</Window>