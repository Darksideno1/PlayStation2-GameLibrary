<Window x:Class="PlayStation2GameLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLAYSTATION 2 GAME LIBRARY — v0.1 BETA"
        Width="1600" Height="900" MinWidth="1180" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#EEF5FB">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#29466D"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2F82E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2F82E5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D3E1EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5C7189"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,10,4"/>
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#17314D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MetricNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#10243F"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="54"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E6F0F8" BorderBrush="#C9D9E8" BorderThickness="0,0,0,1">
            <DockPanel Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="7" Background="#111827" Margin="0,0,10,0">
                        <TextBlock Text="PS" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PLAYSTATION 2 GAME LIBRARY" FontWeight="SemiBold" FontSize="13" Foreground="#213A57" VerticalAlignment="Center"/>
                    <Border Background="#DDEEFF" CornerRadius="7" Margin="12,0,0,0" Padding="8,4">
                        <TextBlock Text="v0.1 BETA" Foreground="#1264BD" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F8FBFE" BorderBrush="#D5E2EE" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,20">
                        <TextBlock Text="Version 0.1 BETA" FontSize="10" Foreground="#74859B"/>
                        <TextBlock x:Name="DatabaseCountText" Text="Catalogue: 0 games" FontSize="10" Foreground="#74859B" Margin="0,5,0,0"/>
                        <TextBlock x:Name="PortablePathText" Text="Portable data" FontSize="9" Foreground="#92A0B2" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="12,22,12,0">
                        <Button x:Name="CatalogNavButton" Style="{StaticResource NavButton}" Content="🎮  Catalog" Click="Catalogue_Click" Background="#DCEEFF" Foreground="#1264BD"/>
                        <Button x:Name="CollectionNavButton" Style="{StaticResource NavButton}" Content="◉  My Collection" Click="Collection_Click"/>
                        <Button x:Name="DashboardNavButton" Style="{StaticResource NavButton}" Content="▥  Dashboard" Click="Dashboard_Click"/>
                        <Button x:Name="ImportExportNavButton" Style="{StaticResource NavButton}" Content="⇅  Import / Export" Click="ImportExport_Click"/>
                        <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Content="⚙  Settings" Click="Settings_Click"/>
                        <Button x:Name="HelpNavButton" Style="{StaticResource NavButton}" Content="?  Help" Click="Help_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="18,18,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="PageTitle" Text="Catalog" FontSize="30" FontWeight="Bold" Foreground="#10243F"/>
                    <TextBlock x:Name="PageSubtitle" Text="Browse and explore PlayStation 2 games." FontSize="13" Foreground="#60758D" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <!-- CATALOG -->
                    <Grid x:Name="CatalogPage">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="385"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="SearchBox" Grid.Column="0" Height="38" Padding="10,7" FontSize="12" TextChanged="SearchBox_TextChanged" ToolTip="Search title, publisher, developer or disc serial"/>
                                        <Button Content="Clear" Grid.Column="1" Margin="8,0,0,0" Click="ClearFilters_Click"/>
                                    </Grid>
                                    <UniformGrid Columns="3" Margin="0,0,0,7">
                                        <ComboBox x:Name="RegionFilter" Height="36" Margin="0,0,6,0" SelectionChanged="RegionFilter_SelectionChanged">
                                            <ComboBoxItem Content="All regions" IsSelected="True"/><ComboBoxItem Content="PAL"/><ComboBoxItem Content="NTSC-U/C"/><ComboBoxItem Content="NTSC-J"/>
                                        </ComboBox>
                                        <ComboBox x:Name="LanguageFilter" Height="36" Margin="3,0" SelectionChanged="LanguageFilter_SelectionChanged">
                                            <ComboBoxItem Content="All languages" Tag="" IsSelected="True"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="French" Tag="fr"/><ComboBoxItem Content="German" Tag="de"/><ComboBoxItem Content="Italian" Tag="it"/><ComboBoxItem Content="Spanish" Tag="es"/><ComboBoxItem Content="Japanese" Tag="ja"/>
                                        </ComboBox>
                                        <ComboBox x:Name="ReleaseTypeFilter" Height="36" Margin="6,0,0,0" SelectionChanged="ReleaseTypeFilter_SelectionChanged">
                                            <ComboBoxItem Content="All release types" IsSelected="True"/><ComboBoxItem Content="Retail"/><ComboBoxItem Content="Platinum"/>
                                        </ComboBox>
                                    </UniformGrid>
                                    <TextBlock x:Name="ResultCountText" Text="0 games" Foreground="#63778F" FontSize="11" Margin="2,0,0,9"/>
                                </StackPanel>
                                <DataGrid x:Name="GamesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="42" SelectionChanged="GamesGrid_SelectionChanged" MouseDoubleClick="GamesGrid_MouseDoubleClick" Background="White" HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding PrimarySerial}" Width="110" MinWidth="100"/>
                                        <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="250" MinWidth="190"/>
                                        <DataGridTemplateColumn Header="REGION" Width="110" MinWidth="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{Binding RegionFlag}" Width="24" Height="16" Stretch="Fill" Margin="0,0,6,0"/><TextBlock Text="{Binding Region}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="LANGUAGES" Width="150" MinWidth="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><ItemsControl ItemsSource="{Binding LanguageFlags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding}" Width="22" Height="15" Stretch="Fill" Margin="0,0,5,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTextColumn Header="RELEASE" Binding="{Binding ReleaseType}" Width="80" MinWidth="70"/>
                                        <DataGridTextColumn Header="OWNED" Binding="{Binding Owned}" Width="85" MinWidth="75"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                                    <Button Content="Open Game Details" Style="{StaticResource PrimaryButton}" Click="GameDetails_Click"/>
                                    <Button Content="+ Add to Collection" Style="{StaticResource PrimaryButton}" Click="AddGame_Click" Margin="0,7,0,0"/>
                                    <Button x:Name="ImportCatalogueButton" Content="Import catalogue (ADMIN)" Click="ImportCatalogue_Click" Margin="0,7,0,0"/>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Height="310" Background="#F4F7FA" BorderBrush="#D3E1EE" BorderThickness="1" CornerRadius="10" Padding="8">
                                            <Grid><Image x:Name="SelectedGameCoverImage" Stretch="Uniform" Visibility="Collapsed"/><StackPanel x:Name="NoCoverPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="▧" FontSize="42" Foreground="#9FB0C4" HorizontalAlignment="Center"/><TextBlock Text="No cover available" FontWeight="SemiBold" Foreground="#60758D" Margin="0,8,0,0"/></StackPanel></Grid>
                                        </Border>
                                        <TextBlock x:Name="SelectedGameTitleText" Text="Select a game" FontSize="22" FontWeight="Bold" Foreground="#10243F" TextWrapping="Wrap" Margin="0,14,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Style="{StaticResource MetaLabel}" Text="Primary serial:"/><TextBlock x:Name="SelectedGamePrimarySerialText" Grid.Row="0" Grid.Column="1" Style="{StaticResource MetaValue}" Text="—"/>
                                            <TextBlock Grid.Row="1" Style="{StaticResource MetaLabel}" Text="Region:"/><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><Image x:Name="SelectedRegionFlag" Width="26" Height="17" Stretch="Fill" Margin="0,4,7,4"/><TextBlock x:Name="SelectedGameRegionText" Style="{StaticResource MetaValue}" Text="—"/></StackPanel>
                                            <TextBlock Grid.Row="2" Style="{StaticResource MetaLabel}" Text="Languages:"/><StackPanel x:Name="SelectedLanguageFlagsPanel" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4"/>
                                            <TextBlock Grid.Row="3" Style="{StaticResource MetaLabel}" Text="Release type:"/><TextBlock x:Name="SelectedGameReleaseTypeText" Grid.Row="3" Grid.Column="1" Style="{StaticResource MetaValue}" Text="—"/>
                                            <TextBlock Grid.Row="4" Style="{StaticResource MetaLabel}" Text="Collection:"/><TextBlock x:Name="SelectedGameOwnedText" Grid.Row="4" Grid.Column="1" Style="{StaticResource MetaValue}" Text="Not in collection"/>
                                        </Grid>
                                        <TextBlock x:Name="SelectedGameInfoText" Text="Choose a game from the catalogue to see its information." Foreground="#60758D" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- MY COLLECTION -->
                    <Grid x:Name="CollectionPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="410"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal"><Button x:Name="PhysicalTabButton" Content="Physical" Style="{StaticResource PrimaryButton}" Click="PhysicalCollection_Click"/><Button x:Name="DigitalTabButton" Content="Digital" Margin="8,0,0,0" Click="DigitalCollection_Click"/></StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="+ Add copy" Style="{StaticResource PrimaryButton}" Click="CollectionAdd_Click"/><Button Content="Edit selected" Margin="8,0,0,0" Click="CollectionEdit_Click"/></StackPanel>
                                    </Grid>
                                    <TextBox x:Name="CollectionSearchBox" Height="36" Padding="10,6" TextChanged="CollectionSearch_TextChanged" ToolTip="Search My Collection" Margin="0,0,0,9"/>
                                    <TextBlock x:Name="CollectionSummaryText" Foreground="#63778F" FontSize="11" Margin="2,0,0,9"/>
                                </StackPanel>
                                <DataGrid x:Name="CollectionGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="42" SelectionChanged="CollectionGrid_SelectionChanged">
                                    <DataGrid.Columns><DataGridTextColumn Header="GAME TITLE" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="TYPE" Binding="{Binding CopyType}" Width="90"/><DataGridTextColumn Header="SIZE" Binding="{Binding SizeDisplay}" Width="100"/><DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="220"/></DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                                <Border Height="280" Background="#F4F7FA" BorderBrush="#D3E1EE" BorderThickness="1" CornerRadius="10" Padding="8"><Grid><Image x:Name="CollectionCoverImage" Stretch="Uniform" Visibility="Collapsed"/><StackPanel x:Name="CollectionNoCover" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="▧" FontSize="38" Foreground="#9FB0C4" HorizontalAlignment="Center"/><TextBlock Text="No cover available" Foreground="#60758D" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Grid></Border>
                                <TextBlock x:Name="CollectionSelectedTitle" Text="Select a copy" FontSize="22" FontWeight="Bold" Foreground="#10243F" TextWrapping="Wrap" Margin="0,14,0,10"/>
                                <Border Background="#EAF5FF" CornerRadius="10" Padding="11" Margin="0,0,0,12"><TextBlock x:Name="CollectionSelectedBadge" Text="No copy selected" Foreground="#355D83" FontWeight="SemiBold"/></Border>
                                <TextBlock Text="Selected Copy Details" FontSize="16" FontWeight="SemiBold" Foreground="#17314D"/>
                                <TextBlock x:Name="CollectionSelectedDetails" Text="Choose a row to view its details." Foreground="#60758D" TextWrapping="Wrap" Margin="0,7,0,12"/>
                                <TextBlock Text="Completeness / Digital details" FontSize="16" FontWeight="SemiBold" Foreground="#17314D"/>
                                <TextBlock x:Name="CollectionInventoryDetails" Text="—" Foreground="#60758D" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel></ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- DASHBOARD -->
                    <ScrollViewer x:Name="DashboardPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <UniformGrid Columns="4" Margin="0,0,0,14">
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="GAMES WITH COVER" FontSize="10" FontWeight="Bold" Foreground="#70809A"/><TextBlock x:Name="DashboardWithCover" Style="{StaticResource MetricNumber}" Text="—"/><TextBlock Text="Local front cover available" FontSize="10" Foreground="#70849A"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="MISSING COVERS" FontSize="10" FontWeight="Bold" Foreground="#70809A"/><TextBlock x:Name="DashboardMissingCover" Style="{StaticResource MetricNumber}" Text="—"/><TextBlock Text="No matching local front cover" FontSize="10" Foreground="#70849A"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="COVERAGE" FontSize="10" FontWeight="Bold" Foreground="#70809A"/><TextBlock x:Name="DashboardCoverage" Style="{StaticResource MetricNumber}" Text="—"/><ProgressBar x:Name="DashboardCoverageBar" Height="8" Minimum="0" Maximum="100" Margin="0,7,0,4"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TOTAL DIGITAL SIZE" FontSize="10" FontWeight="Bold" Foreground="#70809A"/><TextBlock x:Name="DashboardDigitalSize" Style="{StaticResource MetricNumber}" Text="—"/><TextBlock x:Name="DashboardDigitalCount" FontSize="10" Foreground="#70849A"/></StackPanel></Border>
                            </UniformGrid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Cover Coverage" FontSize="20" FontWeight="SemiBold" Foreground="#17314D"/><TextBlock Text="One cover per conceptual game, read from the local Covers folder." Foreground="#70849A" FontSize="12" Margin="0,3,0,14"/><Border Width="220" Height="220" CornerRadius="110" BorderBrush="#2F82E5" BorderThickness="18" Background="#F8FBFE" HorizontalAlignment="Center"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="DashboardRingPercent" Text="0%" FontSize="38" FontWeight="Bold" Foreground="#176AC7" HorizontalAlignment="Center"/><TextBlock x:Name="DashboardRingCaption" Text="0 of 0 games" Foreground="#60758D" HorizontalAlignment="Center"/></StackPanel></Border></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Digital Collection" FontSize="20" FontWeight="SemiBold" Foreground="#17314D"/><TextBlock Text="Saved Digital entries are summed automatically." Foreground="#70849A" FontSize="12" Margin="0,3,0,14"/><TextBlock x:Name="DashboardDigitalPanelSize" Text="0 GB" FontSize="34" FontWeight="Bold" Foreground="#176AC7"/><TextBlock x:Name="DashboardDigitalPanelCount" Text="0 digital games" Foreground="#60758D" Margin="0,5,0,0"/><Border Margin="0,18,0,0" Padding="12" Background="#EAF5FF" CornerRadius="10"><TextBlock Text="Digital size comes only from entries marked Digital in My Collection." Foreground="#355D83" TextWrapping="Wrap"/></Border></StackPanel></Border>
                            </Grid>
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Games Without Covers" FontSize="20" FontWeight="SemiBold" Foreground="#17314D"/><TextBlock Text="Sample of catalog games with no matching primary-serial image." Foreground="#70849A" FontSize="12" Margin="0,3,0,10"/><DataGrid x:Name="DashboardMissingGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="220" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Serial}" Width="130"/><DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="REGION" Binding="{Binding Region}" Width="120"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- IMPORT EXPORT -->
                    <ScrollViewer x:Name="ImportExportPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="Create Backup" FontSize="20" FontWeight="SemiBold" Foreground="#17314D"/><TextBlock Text="Create a complete SQLite backup of catalogue and collection data." Foreground="#60758D" TextWrapping="Wrap" Margin="0,4,0,12"/><Button Content="Create Backup" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="CreateBackup_Click"/><TextBlock x:Name="BackupStatusText" Foreground="#60758D" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,10"><StackPanel><TextBlock Text="Restore Backup" FontSize="20" FontWeight="SemiBold" Foreground="#17314D"/><TextBlock Text="Restore a compatible database. A safety copy is created first." Foreground="#60758D" TextWrapping="Wrap" Margin="0,4,0,12"/><Button Content="Select Backup…" HorizontalAlignment="Left" Click="RestoreBackup_Click"/><TextBlock x:Name="RestoreStatusText" Foreground="#60758D" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,10,0"><StackPanel><TextBlock Text="Export My Collection" FontSize="20" FontWeight="SemiBold" Foreground="#17314D"/><TextBlock Text="Export Physical and Digital entries as JSON or CSV." Foreground="#60758D" TextWrapping="Wrap" Margin="0,4,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Export JSON" Style="{StaticResource PrimaryButton}" Click="ExportJson_Click"/><Button Content="Export CSV" Margin="8,0,0,0" Click="ExportCsv_Click"/></StackPanel><TextBlock x:Name="ExportStatusText" Foreground="#60758D" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="10,10,0,0"><StackPanel><TextBlock Text="Import Collection" FontSize="20" FontWeight="SemiBold" Foreground="#17314D"/><TextBlock Text="Import a JSON or CSV collection export. Exact duplicates are skipped." Foreground="#60758D" TextWrapping="Wrap" Margin="0,4,0,12"/><Button Content="Select JSON / CSV…" HorizontalAlignment="Left" Click="ImportCollection_Click"/><TextBlock x:Name="ImportStatusText" Foreground="#60758D" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
                            </Grid>
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Portable Data Location" FontSize="20" FontWeight="SemiBold" Foreground="#17314D"/><TextBlock x:Name="ImportExportDataPathText" Foreground="#60758D" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="Back up the Data folder itself if you want a simple manual copy of the entire library database." Foreground="#70849A" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- SETTINGS -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MEDIA LIBRARY LOCATION" FontSize="11" FontWeight="Bold" Foreground="#1261E8"/><TextBlock Text="Choose the root Media folder. Front covers are read from its Covers subfolder." Foreground="#60758D" Margin="0,5,0,12" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SettingsMediaPathBox" Height="36" Padding="9,6"/><Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="SettingsBrowse_Click"/></Grid><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Test Path" Click="SettingsTest_Click"/><Button Content="Open Covers Folder" Margin="8,0,0,0" Click="SettingsOpenCovers_Click"/></StackPanel><TextBlock Text="Examples: D:\PS2 Media\     \\SYNOLOGY\PS2-Media\     .\Media\" Foreground="#70809A" FontSize="11" Margin="0,9,0,0"/><CheckBox x:Name="SettingsThumbnailCacheCheck" Content="Enable thumbnail cache (recommended)" Margin="0,16,0,0"/><TextBlock x:Name="SettingsStatusText" Foreground="#60758D" TextWrapping="Wrap" Margin="0,10,0,0"/><Button Content="Save Settings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="SettingsSave_Click"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Portable Storage" FontSize="20" FontWeight="SemiBold" Foreground="#17314D"/><TextBlock Text="This build stores its database and settings next to the portable package instead of reusing old test data from Windows AppData." Foreground="#60758D" TextWrapping="Wrap" Margin="0,5,0,10"/><TextBlock x:Name="SettingsDataPathText" Style="{StaticResource MetaValue}"/><TextBlock x:Name="SettingsConfigPathText" Style="{StaticResource MetaValue}"/></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- HELP -->
                    <Grid x:Name="HelpPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="10"><StackPanel><Button Content="Quick Start" Tag="start" Click="HelpTopic_Click"/><Button Content="Catalog" Tag="catalog" Click="HelpTopic_Click"/><Button Content="My Collection" Tag="collection" Click="HelpTopic_Click"/><Button Content="Front Covers" Tag="covers" Click="HelpTopic_Click"/><Button Content="Backup & Restore" Tag="backup" Click="HelpTopic_Click"/><Button Content="Troubleshooting" Tag="troubleshooting" Click="HelpTopic_Click"/><Button Content="About" Tag="about" Click="HelpTopic_Click"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="HelpTopicTitle" Text="Quick Start" FontSize="24" FontWeight="SemiBold" Foreground="#17314D"/><TextBlock x:Name="HelpTopicBody" Foreground="#4E657D" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"/></StackPanel></ScrollViewer></Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Background="#E7F0FC" CornerRadius="7" Padding="9" Margin="0,10,0,0"><TextBlock x:Name="StatusText" Text="Loading local catalogue…" Foreground="#345E94" FontSize="11" TextWrapping="Wrap"/></Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#D8E6F6" BorderThickness="0,1,0,0">
            <UniformGrid Columns="5" Margin="24,6">
                <StackPanel><TextBlock Text="CATALOG" Foreground="#6C88A8" FontSize="10"/><TextBlock x:Name="FooterCatalogText" Text="0 games" FontWeight="Bold" Foreground="#125DBA" FontSize="17"/></StackPanel>
                <StackPanel><TextBlock Text="PHYSICAL" Foreground="#6C88A8" FontSize="10"/><TextBlock x:Name="FooterPhysicalText" Text="0" FontWeight="Bold" Foreground="#125DBA" FontSize="17"/></StackPanel>
                <StackPanel><TextBlock Text="DIGITAL" Foreground="#6C88A8" FontSize="10"/><TextBlock x:Name="FooterDigitalText" Text="0" FontWeight="Bold" Foreground="#125DBA" FontSize="17"/></StackPanel>
                <StackPanel><TextBlock Text="TOTAL DIGITAL SIZE" Foreground="#6C88A8" FontSize="10"/><TextBlock x:Name="FooterSizeText" Text="0 GB" FontWeight="Bold" Foreground="#125DBA" FontSize="17"/></StackPanel>
                <StackPanel><TextBlock Text="COMPLETION" Foreground="#6C88A8" FontSize="10"/><TextBlock x:Name="FooterProgressText" Text="0%" FontWeight="Bold" Foreground="#125DBA" FontSize="17"/></StackPanel>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
