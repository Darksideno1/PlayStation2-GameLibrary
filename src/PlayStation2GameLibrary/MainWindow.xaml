<Window x:Class="PlayStation2GameLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLAYSTATION 2 GAME LIBRARY — v0.1 BETA"
        Width="1600" Height="900" MinWidth="1180" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#EEF5FB">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#29466D"/>
        </Style>
        <Style x:Key="BlueAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2F82E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2F82E5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5C7189"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,10,4"/>
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#17314D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E6F0F8" BorderBrush="#C9D9E8" BorderThickness="0,0,0,1">
            <DockPanel Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Width="28" Height="28" CornerRadius="7" Background="#111827" Margin="0,0,10,0"><TextBlock Text="PS" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                    <TextBlock Text="PLAYSTATION 2 GAME LIBRARY" FontWeight="SemiBold" FontSize="13" Foreground="#213A57" VerticalAlignment="Center"/>
                    <Border Background="#DDEEFF" CornerRadius="7" Margin="12,0,0,0" Padding="8,4"><TextBlock Text="v0.1 BETA" Foreground="#1264BD" FontSize="10" FontWeight="Bold"/></Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F8FBFE" BorderBrush="#D5E2EE" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,20">
                        <TextBlock Text="Version 0.1 BETA" FontSize="10" Foreground="#74859B"/>
                        <TextBlock x:Name="DatabaseCountText" Text="Catalogue: 0 games" FontSize="10" Foreground="#74859B" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="12,22,12,0">
                        <Button Style="{StaticResource NavButton}" Content="🎮  Catalog" Click="Catalogue_Click" Background="#DCEEFF" Foreground="#1264BD"/>
                        <Button Style="{StaticResource NavButton}" Content="◉  My Collection" Click="Collection_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▥  Dashboard" Click="Dashboard_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⇅  Import / Export" Click="ImportExport_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⚙  Settings" Click="Settings_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="?  Help" Click="Help_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="18,18,18,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="PageTitle" Text="Catalog" FontSize="30" FontWeight="Bold" Foreground="#10243F"/>
                    <TextBlock x:Name="PageSubtitle" Text="Browse and explore PlayStation 2 games." FontSize="13" Foreground="#60758D" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" BorderBrush="#D3E1EE" BorderThickness="1" CornerRadius="16" Padding="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="150"/><ColumnDefinition Width="145"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SearchBox" Grid.Column="0" Height="38" Padding="10,7" FontSize="12" TextChanged="SearchBox_TextChanged" ToolTip="Search title, publisher, developer or disc serial"/>
                                    <ComboBox x:Name="RegionFilter" Grid.Column="1" Margin="8,0,0,0" Height="38" SelectionChanged="RegionFilter_SelectionChanged">
                                        <ComboBoxItem Content="All regions" IsSelected="True"/>
                                        <ComboBoxItem Content="PAL"/>
                                        <ComboBoxItem Content="NTSC-U/C"/>
                                        <ComboBoxItem Content="NTSC-J"/>
                                    </ComboBox>
                                    <ComboBox x:Name="LanguageFilter" Grid.Column="2" Margin="8,0,0,0" Height="38" SelectionChanged="LanguageFilter_SelectionChanged">
                                        <ComboBoxItem Content="All languages" Tag="" IsSelected="True"/>
                                        <ComboBoxItem Content="English" Tag="en"/>
                                        <ComboBoxItem Content="French" Tag="fr"/>
                                        <ComboBoxItem Content="German" Tag="de"/>
                                        <ComboBoxItem Content="Italian" Tag="it"/>
                                        <ComboBoxItem Content="Spanish" Tag="es"/>
                                        <ComboBoxItem Content="Japanese" Tag="ja"/>
                                    </ComboBox>
                                    <ComboBox x:Name="ReleaseTypeFilter" Grid.Column="3" Margin="8,0,0,0" Height="38" SelectionChanged="ReleaseTypeFilter_SelectionChanged">
                                        <ComboBoxItem Content="All release types" IsSelected="True"/>
                                        <ComboBoxItem Content="Retail"/>
                                        <ComboBoxItem Content="Platinum"/>
                                    </ComboBox>
                                    <Button Content="Clear" Grid.Column="4" Margin="8,0,0,0" Click="ClearFilters_Click"/>
                                </Grid>
                                <TextBlock x:Name="ResultCountText" Text="0 games" Foreground="#63778F" FontSize="11" Margin="2,0,0,9"/>
                            </StackPanel>

                            <DataGrid x:Name="GamesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="42"
                                      SelectionChanged="GamesGrid_SelectionChanged" MouseDoubleClick="GamesGrid_MouseDoubleClick" Background="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding PrimarySerial}" Width="115"/>
                                    <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="2.2*"/>
                                    <DataGridTemplateColumn Header="REGION" Width="120">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{Binding RegionFlag}" Width="24" Height="16" Stretch="Fill" Margin="0,0,6,0"/><TextBlock Text="{Binding Region}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="LANGUAGES" Width="160">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ItemsControl ItemsSource="{Binding LanguageFlags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding}" Width="22" Height="15" Stretch="Fill" Margin="0,0,5,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="RELEASE" Binding="{Binding ReleaseType}" Width="85"/>
                                    <DataGridTextColumn Header="OWNED" Binding="{Binding Owned}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" BorderBrush="#D3E1EE" BorderThickness="1" CornerRadius="16" Margin="16,0,0,0" Padding="18">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                                <Button Content="Open Game Details" Style="{StaticResource BlueAction}" Click="GameDetails_Click"/>
                                <Button Content="+ Add to Collection" Style="{StaticResource BlueAction}" Click="AddGame_Click" Margin="0,7,0,0"/>
                                <Button x:Name="ImportCatalogueButton" Content="Import catalogue (ADMIN)" Click="ImportCatalogue_Click" Margin="0,7,0,0"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Height="350" Background="#F4F7FA" BorderBrush="#D3E1EE" BorderThickness="1" CornerRadius="10" Padding="8">
                                        <Grid>
                                            <Image x:Name="SelectedGameCoverImage" Stretch="Uniform" Visibility="Collapsed"/>
                                            <StackPanel x:Name="NoCoverPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="▧" FontSize="42" Foreground="#9FB0C4" HorizontalAlignment="Center"/>
                                                <TextBlock Text="No cover available" FontWeight="SemiBold" Foreground="#60758D" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="SelectedGameTitleText" Text="Select a game" FontSize="22" FontWeight="Bold" Foreground="#10243F" TextWrapping="Wrap" Margin="0,14,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Style="{StaticResource MetaLabel}" Text="Primary serial:"/><TextBlock x:Name="SelectedGamePrimarySerialText" Grid.Row="0" Grid.Column="1" Style="{StaticResource MetaValue}" Text="—"/>
                                        <TextBlock Grid.Row="1" Style="{StaticResource MetaLabel}" Text="Region:"/><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><Image x:Name="SelectedRegionFlag" Width="26" Height="17" Stretch="Fill" Margin="0,4,7,4"/><TextBlock x:Name="SelectedGameRegionText" Style="{StaticResource MetaValue}" Text="—"/></StackPanel>
                                        <TextBlock Grid.Row="2" Style="{StaticResource MetaLabel}" Text="Languages:"/><StackPanel x:Name="SelectedLanguageFlagsPanel" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4"/>
                                        <TextBlock Grid.Row="3" Style="{StaticResource MetaLabel}" Text="Release type:"/><TextBlock x:Name="SelectedGameReleaseTypeText" Grid.Row="3" Grid.Column="1" Style="{StaticResource MetaValue}" Text="—"/>
                                        <TextBlock Grid.Row="4" Style="{StaticResource MetaLabel}" Text="Collection:"/><TextBlock x:Name="SelectedGameOwnedText" Grid.Row="4" Grid.Column="1" Style="{StaticResource MetaValue}" Text="Not in collection"/>
                                    </Grid>
                                    <TextBlock x:Name="SelectedGameInfoText" Text="Choose a game from the catalogue to see its information." Foreground="#60758D" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="#E7F0FC" CornerRadius="7" Padding="9" Margin="0,10,0,0">
                    <TextBlock x:Name="StatusText" Text="Loading local catalogue…" Foreground="#345E94" FontSize="11" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#D8E6F6" BorderThickness="0,1,0,0">
            <UniformGrid Columns="5" Margin="24,6">
                <StackPanel><TextBlock Text="CATALOG" Foreground="#6C88A8" FontSize="10"/><TextBlock x:Name="FooterCatalogText" Text="0 games" FontWeight="Bold" Foreground="#125DBA" FontSize="17"/></StackPanel>
                <StackPanel><TextBlock Text="PHYSICAL" Foreground="#6C88A8" FontSize="10"/><TextBlock x:Name="FooterPhysicalText" Text="0" FontWeight="Bold" Foreground="#125DBA" FontSize="17"/></StackPanel>
                <StackPanel><TextBlock Text="DIGITAL" Foreground="#6C88A8" FontSize="10"/><TextBlock x:Name="FooterDigitalText" Text="0" FontWeight="Bold" Foreground="#125DBA" FontSize="17"/></StackPanel>
                <StackPanel><TextBlock Text="TOTAL DIGITAL SIZE" Foreground="#6C88A8" FontSize="10"/><TextBlock x:Name="FooterSizeText" Text="0 GB" FontWeight="Bold" Foreground="#125DBA" FontSize="17"/></StackPanel>
                <StackPanel><TextBlock Text="COMPLETION" Foreground="#6C88A8" FontSize="10"/><TextBlock x:Name="FooterProgressText" Text="0%" FontWeight="Bold" Foreground="#125DBA" FontSize="17"/></StackPanel>
            </UniformGrid>
        </Border>
    </Grid>
</Window>