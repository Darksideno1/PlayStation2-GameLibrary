<Window x:Class="PlayStation2GameLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLAYSTATION 2 GAME LIBRARY — v0.1 BETA"
        Width="1600" Height="900" MinWidth="1180" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F3F7FC">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#29466D"/>
        </Style>
        <Style x:Key="BlueAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0866CC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0866CC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#DBE4EF" BorderThickness="0,0,0,1">
            <DockPanel Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Width="33" Height="33" CornerRadius="8" Background="#1261E8" Margin="0,0,11,0"><TextBlock Text="PS2" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                    <TextBlock Text="PLAYSTATION 2" FontWeight="Bold" FontSize="15" Foreground="#17233A" VerticalAlignment="Center"/>
                    <TextBlock Text="  GAME LIBRARY" FontWeight="SemiBold" FontSize="12" Foreground="#70809A" VerticalAlignment="Center"/>
                    <Border Background="#EAF2FF" CornerRadius="7" Margin="14,0,0,0" Padding="8,4"><TextBlock Text="v0.1 BETA" Foreground="#1261E8" FontSize="10" FontWeight="Bold"/></Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Catalog" Click="Catalogue_Click" Margin="0,0,8,0"/>
                    <Button Content="My Collection" Click="Collection_Click" Style="{StaticResource BlueAction}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#DCE7F5" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,22,12,24">
                        <TextBlock Text="WORKSPACE" FontWeight="Bold" FontSize="10" Foreground="#70809A" Margin="10,0,0,10"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="15,0,15,20">
                        <TextBlock Text="Version 0.1 BETA" FontSize="10" Foreground="#74859B"/>
                        <TextBlock x:Name="DatabaseCountText" Text="Catalogue: 0 games" FontSize="10" Foreground="#74859B" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <Button Style="{StaticResource NavButton}" Content="🎮  Catalog" Click="Catalogue_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▣  My Collection" Click="Collection_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▥  Dashboard / Statistics" Click="Dashboard_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⇅  Import / Export" Click="ImportExport_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⚙  Settings" Click="Settings_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="?  Help" Click="Help_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="19,16,19,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,13">
                    <TextBlock x:Name="PageTitle" Text="🎮 Catalog" FontSize="22" FontWeight="Bold" Foreground="#143C74"/>
                    <TextBlock x:Name="PageSubtitle" Text="   Browse the worldwide game catalogue" FontSize="11" Foreground="#7088A8" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" BorderBrush="#D8E6F6" BorderThickness="1" CornerRadius="12" Padding="17">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="SearchBox" Grid.Column="0" Height="33" Padding="9,6" FontSize="12" TextChanged="SearchBox_TextChanged" ToolTip="Search title, publisher, developer or disc serial"/>
                                    <Button Content="Clear" Grid.Column="1" Margin="8,0,0,0" Click="ClearFilters_Click"/>
                                </Grid>
                                <WrapPanel Margin="0,0,0,10">
                                    <ComboBox x:Name="RegionFilter" Width="170" Height="30" SelectionChanged="RegionFilter_SelectionChanged">
                                        <ComboBoxItem Content="All regions" IsSelected="True"/>
                                        <ComboBoxItem Content="Europe / PAL"/>
                                        <ComboBoxItem Content="North America"/>
                                        <ComboBoxItem Content="Japan"/>
                                        <ComboBoxItem Content="Asia"/>
                                        <ComboBoxItem Content="Korea"/>
                                        <ComboBoxItem Content="Australia"/>
                                        <ComboBoxItem Content="Other / Unknown"/>
                                    </ComboBox>
                                    <TextBlock x:Name="ResultCountText" Text="0 results" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#55779D" FontSize="11"/>
                                </WrapPanel>
                            </StackPanel>
                            <DataGrid x:Name="GamesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="35"
                                      SelectionChanged="GamesGrid_SelectionChanged" Background="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="2.2*"/>
                                    <DataGridTextColumn Header="YEAR" Binding="{Binding Year}" Width="66"/>
                                    <DataGridTextColumn Header="RELEASES" Binding="{Binding ReleaseCount}" Width="77"/>
                                    <DataGridTextColumn Header="LANGUAGES" Binding="{Binding Languages}" Width="1*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Background="White" BorderBrush="#D8E6F6" BorderThickness="1" CornerRadius="12" Margin="16,0,0,0" Padding="17">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom">
                                <Button Content="VIEW DETAILS" Style="{StaticResource BlueAction}" Click="GameDetails_Click"/>
                                <Button Content="+ ADD TO COLLECTION" Style="{StaticResource BlueAction}" Click="AddGame_Click"/>
                                <Button x:Name="ImportCatalogueButton" Content="Import catalogue (ADMIN)" Click="ImportCatalogue_Click"/>
                            </StackPanel>
                            <StackPanel>
                                <Border Background="#E7F0FC" CornerRadius="7" Height="165" Margin="0,0,0,13">
                                    <TextBlock Text="NO COVER IMAGE" Foreground="#5982B7" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="SelectedGameTitleText" Text="Select a game" FontSize="17" FontWeight="Bold" Foreground="#183D73" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SelectedGameInfoText" Text="Choose a game from the catalogue to see its information and add it to your collection." Foreground="#607A9A" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="2" Background="#E7F0FC" CornerRadius="5" Padding="9" Margin="0,10,0,0">
                    <TextBlock x:Name="StatusText" Text="Loading local catalogue…" Foreground="#345E94" FontSize="11" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#D8E6F6" BorderThickness="0,1,0,0">
            <UniformGrid Columns="6" Margin="24,5">
                <StackPanel><TextBlock Text="🎮  CATALOG" Foreground="#6C88A8" FontSize="10"/><TextBlock x:Name="FooterCatalogText" Text="0 games" FontWeight="Bold" Foreground="#125DBA" FontSize="17"/></StackPanel>
                <StackPanel><TextBlock Text="◉  PHYSICAL" Foreground="#6C88A8" FontSize="10"/><TextBlock x:Name="FooterPhysicalText" Text="0" FontWeight="Bold" Foreground="#125DBA" FontSize="17"/></StackPanel>
                <StackPanel><TextBlock Text="☁  DIGITAL" Foreground="#6C88A8" FontSize="10"/><TextBlock x:Name="FooterDigitalText" Text="0" FontWeight="Bold" Foreground="#125DBA" FontSize="17"/></StackPanel>
                <StackPanel><TextBlock Text="▣  OPL" Foreground="#6C88A8" FontSize="10"/><TextBlock x:Name="FooterOplText" Text="0" FontWeight="Bold" Foreground="#125DBA" FontSize="17"/></StackPanel>
                <StackPanel><TextBlock Text="▤  DIGITAL SIZE" Foreground="#6C88A8" FontSize="10"/><TextBlock x:Name="FooterSizeText" Text="0 GB" FontWeight="Bold" Foreground="#125DBA" FontSize="17"/></StackPanel>
                <StackPanel><TextBlock Text="◫  COMPLETION" Foreground="#6C88A8" FontSize="10"/><TextBlock x:Name="FooterProgressText" Text="0%" FontWeight="Bold" Foreground="#125DBA" FontSize="17"/></StackPanel>
            </UniformGrid>
        </Border>
    </Grid>
</Window>